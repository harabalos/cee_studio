# =====================================================================
# CEE Studio — Environment Variables (copy to .env.local and fill in)
# =====================================================================
# .env.local is gitignored. Never commit real keys.

# --- SITE -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SUPABASE ---------------------------------------------------------
# Create project at https://supabase.com (region: Frankfurt for low CH latency)
# After creating, find these in: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses RLS. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# --- STRIPE -----------------------------------------------------------
# Switzerland Stripe account, default currency CHF
# Enable TWINT in: Settings -> Payment methods
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# After creating webhook endpoint at /api/webhooks/stripe, paste signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# --- RESEND -----------------------------------------------------------
# https://resend.com — verify domain ceestudio.ch (DNS: SPF + DKIM + DMARC)
RESEND_API_KEY=re_...
RESEND_FROM="CEE Studio <bookings@ceestudio.ch>"

# --- ADMIN ------------------------------------------------------------
# Comma-separated emails that get admin access (matches against magic-link login)
ADMIN_ALLOWED_EMAILS=info@ceestudio.ch

# --- CRON -------------------------------------------------------------
# Random secret. Vercel Cron passes this in Authorization header to protect
# /api/cron/* routes from public abuse.
CRON_SECRET=

# --- OWNER iCAL FEED --------------------------------------------------
# Random token. Owner subscribes to:
#   /api/calendar/owner.ics?token=<this>
# in Apple Calendar / Google Calendar / Outlook for live sync.
OWNER_ICS_TOKEN=
